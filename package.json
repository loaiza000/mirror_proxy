{
  "name": "mirrotap",
  "version": "1.0.0",
  "description": "Production-grade traffic shadowing and replay system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "proxy",
    "shadowing",
    "traffic-replay",
    "observability"
  ],
  "author": "MirrorProxy Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/exporter-prometheus": "^0.45.0",
    "@opentelemetry/sdk-node": "^0.45.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "mongoose": "^9.2.1",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.0",
    "prom-client": "^15.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.45.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.19.33",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
